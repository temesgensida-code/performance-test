      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"social-api\"}[30s])))",
          "legendFormat": "p95 {{handler}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "FastAPI p95 Response Time by Endpoint",
      "type": "timeseries"
