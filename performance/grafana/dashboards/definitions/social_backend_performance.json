          "editorMode": "code",
          "expr": "sum by (handler, method) (rate(http_requests_total{job=\"social-api\"}[15s]))",
          "legendFormat": "{{method}} {{handler}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "FastAPI Request Rate by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
